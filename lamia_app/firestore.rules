rules_version = '2';

// La Mia — Firestore Security Rules
//
// Implements the security model described in `La Mia - Architecture
// (Flutter + Firebase).md` §5. The current data model does not yet carry
// every field the doc lists (status, authorId, likeCount, ratingAvg), so
// these rules are written to:
//   1. Forward-enable the documented model (guarded by field presence),
//   2. Lock down writes today to signed-in users + their own data,
//   3. Treat popularity/moderation fields as server-authoritative — clients
//      can never directly set status, likeCount, ratingAvg, ratingCount,
//      trendingScore, or commentCount, even when those fields exist.
//
// Deploy with: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Admins are stored on the user doc as `role == 'admin'`. Admin checks
    // require reading the user document, so they cost one read per
    // admin-gated request — acceptable for moderation paths.
    function isAdmin() {
      return isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid))
                .data.role == 'admin';
    }

    /// `true` if the requesting user is the author of `resource`.
    function isAuthor() {
      return isSignedIn()
          && resource.data.authorId == request.auth.uid;
    }

    /// `true` if this request is attempting to mutate the moderation
    /// `status` field. Used to forbid self-approval on update.
    function changingStatus() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['status']);
    }

    /// Server-authoritative fields on CREATE. Clients can never set these fields on creation.
    function notSettingServerFieldsOnCreate() {
      return !request.resource.data.keys().hasAny([
        'approvedAt', 'likeCount', 'commentCount',
        'favoriteCount', 'ratingAvg', 'ratingCount', 'trendingScore'
      ]);
    }

    /// Server-authoritative fields on UPDATE. Clients can never update these.
    function notSettingServerFieldsOnUpdate() {
      return !request.resource.data.diff(resource.data)
          .affectedKeys().hasAny([
            'status', 'approvedAt', 'likeCount', 'commentCount',
            'favoriteCount', 'ratingAvg', 'ratingCount', 'trendingScore'
          ]);
    }

    // ── Recipes ────────────────────────────────────────────────────────────

    match /recipes/{id} {

      // Read: public reads of approved recipes. Authors and admins can
      // always read their own/pending content. Until `status` exists on
      // every doc, fall back to public read (matches current seed data).
      allow read: if (
        !('status' in resource.data)
        || resource.data.status == 'approved'
        || isAuthor()
        || isAdmin()
      );

      // Create: signed-in user, must own the recipe, status forced to
      // 'pending' (all user recipes enter moderation queue).
      // Server-authoritative fields must NOT be set by the client.
      // Structural validation ensures the document resembles a real recipe.
      allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid
          // ── Force pending status (no self-approval) ──
          && request.resource.data.status == 'pending'
          // ── Structural: required fields exist & have correct types ──
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 3
          && request.resource.data.name.size() <= 150
          && request.resource.data.description is string
          && request.resource.data.category is string
          && request.resource.data.category in [
               'Almusal', 'Ulam', 'Sabaw', 'Merienda',
               'Panghimagas', 'Gulay', 'Inihaw', 'Lamang Dagat'
             ]
          && request.resource.data.difficulty is string
          && request.resource.data.difficulty in ['Easy', 'Medium', 'Hard']
          && request.resource.data.ingredients is list
          && request.resource.data.ingredients.size() >= 2
          && request.resource.data.instructions is list
          && request.resource.data.instructions.size() >= 2
          && request.resource.data.servings is int
          && request.resource.data.servings > 0
          && request.resource.data.coverPhotoUrl is string
          && request.resource.data.coverPhotoUrl.size() > 0
          && request.resource.data.prepTime is string
          && request.resource.data.cookTime is string
          // ── Deny server-authoritative fields on create ──
          && notSettingServerFieldsOnCreate();

      // Update: author may edit non-status fields of their own recipe;
      // admin may update anything (including status approval). Clients
      // can never mutate the server-authoritative counters via either path.
      allow update: if (
        (
          isAuthor()
          && !changingStatus()
          && notSettingServerFieldsOnUpdate()
        )
        || isAdmin()
      );

      // Delete: author or admin.
      allow delete: if isAuthor() || isAdmin();
    }

    // ── Ratings (one per user per recipe) ───────────────────────────────────

    match /recipes/{recipeId}/ratings/{userId} {
      allow read: if isSignedIn();
      allow write: if isUser(userId)
          && request.resource.data.value is number
          && request.resource.data.value >= 1
          && request.resource.data.value <= 5;
    }

    // ── Users ──────────────────────────────────────────────────────────────

    match /users/{uid} {
      // Profiles are needed by search, recipe attribution, and other-user
      // profile screens. Keep them visible to all visitors (including guests).
      allow read: if true;

      // First-creation on sign-up goes through AuthService, which forces
      // the role to 'user' and never lets clients elevate themselves.
      allow create: if isUser(uid)
          && request.resource.data.role == 'user';

      // Update own profile — but never the role field (admin-only),
      // and never the server-authoritative counters.
      allow update: if (
        (isUser(uid) && !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny([
              'role', 'recipeCount', 'totalLikesReceived',
              'followerCount', 'followingCount', 'savedCount'
            ]))
        || isAdmin()
      );

      allow delete: if isUser(uid);
    }

    // ── Moderation Logs (written by Cloud Functions, readable by admins) ────

    match /moderationLogs/{logId} {
      // Admins can read moderation logs from the admin dashboard.
      // Cloud Functions write via Admin SDK (bypasses these rules).
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions can write
    }

    // ── Everything else: deny by default ─────────────────────────────────────

    // Collections not explicitly named above are inaccessible to clients.
    // (新时期) New collections must add a deliberate rule here.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
